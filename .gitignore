# Quarto build artifacts
/.quarto/
/_site/
/_freeze/
*_files/
**/*.quarto_ipynb

# R / RStudio session files
.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.Rproj

# Local Claude config (machine-specific)
.claude/settings.local.json
.claude/state/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/

# CV outputs (rendered by CI from huntermartaindale/cv; sync locally
# for preview with: Rscript scripts/sync_cv.R)
/cv/index.html
/cv/martaindale_cv.pdf

# Paper PDFs now live in the CV repo (huntermartaindale/cv at pubs/) and are
# copied in by CI at deploy time (and by scripts/sync_cv.R for local preview).
# Not tracked here to avoid a second, drift-prone copy.
/pubs/
